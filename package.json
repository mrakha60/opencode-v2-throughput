{
  "name": "opencode-throughput",
  "version": "3.0.0",
  "description": "Real-time LLM performance monitoring for OpenCode. Tracks TTFT, TPS, latency, token usage and cost per model, with a sidebar widget, toast notifications and JSONL logging.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./types": "./src/types.ts",
    "./stats": "./src/stats.ts",
    "./format": "./src/format.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "llm",
    "benchmark",
    "throughput",
    "latency",
    "ttft",
    "tps",
    "monitoring",
    "performance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrakha60/opencode-throughput.git"
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "^2.0.32",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/node": "^25.5.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0"
  }
}