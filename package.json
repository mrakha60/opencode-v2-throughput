{
  "name": "opencode-v2-throughput",
  "version": "3.0.1",
  "description": "Live LLM speed metrics for OpenCode v2: TTFT, TPS, latency, token usage and cost per model, with a sidebar widget, per-request toasts, and a benchmark tool.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./types": "./src/types.ts",
    "./stats": "./src/stats.ts",
    "./format": "./src/format.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-install.mjs",
    "verify": "npm run typecheck && npm run sync && npx tsx scripts/verify-plugin-shape.ts && npx tsx scripts/verify-behavior.ts && npx tsx scripts/verify-tui-setup.ts && npx tsx scripts/check-opentui-conflict.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "opencode-tui-plugin",
    "llm",
    "benchmark",
    "throughput",
    "latency",
    "ttft",
    "tps",
    "monitoring",
    "performance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrakha60/opencode-v2-throughput.git"
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "^2.0.32",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/node": "^25.5.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0"
  }
}